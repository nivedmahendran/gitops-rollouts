---
# Kubernetes and Argo manifests use long lines (PromQL, URLs, securityContext
# values); a hard line-length limit fights that without adding value.
extends: default

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  # Document-start style varies legitimately: multi-document K8s files need
  # `---` separators, single-document files usually omit it. Enforcing either
  # direction produces noise about form rather than correctness.
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 0
  indentation:
    spaces: 2
    indent-sequences: consistent
  key-duplicates: enable
  empty-lines:
    max: 2
